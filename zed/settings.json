// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // ===== 外観 (テーマ・アイコン) =====
  // エディタのカラーテーマ。OS のダーク/ライトモードに追従
  // dark: "Terafox - blurred" は nvim-nightfox 拡張に同梱
  //   https://github.com/cange/nightfox.zed
  "diff_view_style": "split",
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Terafox - blurred",
  },
  // ファイルツリー等で使うアイコンテーマ
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },

  // ===== フォント =====
  // UI 全体のフォントサイズ (サイドバー・コマンドパレット等)
  "ui_font_size": 15,
  // エディタ本文のフォントサイズ
  "buffer_font_size": 12,
  // エディタ本文のフォントウェイト (400 = Regular)
  "buffer_font_weight": 400,
  // エディタの行間 (standard / comfortable / custom)
  "buffer_line_height": "comfortable",
  // UI フォント (サイドバー・タブ・コマンドパレット等)。
  // 日本語グリフは fallbacks 経由でヒラギノ丸ゴ ProN へ流す
  "ui_font_family": ".SystemUIFont",
  "ui_font_fallbacks": ["Hiragino Maru Gothic ProN"],
  // エディタ本文フォント。同様に日本語だけ丸ゴへフォールバック
  "buffer_font_family": ".ZedMono",
  "buffer_font_fallbacks": ["Hiragino Maru Gothic ProN"],
  // リガチャ (calt) を無効化。=== や != などが合字でつながって見えるのを防ぐ
  "buffer_font_features": {
    "calt": false,
  },

  // ===== エディタ表示 =====
  // 空白文字 (スペース・タブ) を常時可視化
  "show_whitespaces": "all",
  // カーソル行のハイライト範囲 (none / gutter / line / all)
  "current_line_highlight": "all",
  // 選択中のテキストと同一の箇所をハイライト
  "selection_highlight": true,
  // 未使用コード (dead code) を薄く表示する不透明度 (0.0〜1.0)
  "unnecessary_code_fade": 0.4,
  // 折り返しガイド (縦ライン) を指定桁に表示
  "show_wrap_guides": true,
  "wrap_guides": [80, 100],

  // ----- カーソル -----
  // カーソル形状 (bar / block / underline / hollow)
  "cursor_shape": "bar",
  // カーソルの点滅
  "cursor_blink": true,
  // 入力中はマウスカーソルを隠す (never / on_typing / on_typing_and_action)
  "hide_mouse": "on_typing",

  // ----- インデントガイド -----
  // インデントの縦ガイド線
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    // ネストの深さに応じて色を変える (disabled / fixed / indent_aware)
    "coloring": "indent_aware",
    "background_coloring": "disabled",
  },

  // ----- ガター (行番号の列) -----
  "gutter": {
    "line_numbers": true,
    // テスト等の実行ボタン
    "runnables": true,
    // コード折りたたみハンドル
    "folds": true,
    // 行番号欄の最小桁数 (狭めて余白を節約)
    "min_line_number_digits": 3,
  },

  // ----- スクロールバー -----
  "scrollbar": {
    // 表示条件 (auto / system / always / never)
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    // 診断マーカーの表示レベル (none / error / warning / information / all)
    "diagnostics": "all",
  },

  // ----- ミニマップ -----
  "minimap": {
    // 表示条件 (auto / always / never)
    "show": "auto",
    // つまみの表示 (always / hover)
    "thumb": "hover",
    "thumb_border": "left_open",
  },

  // ===== タブ =====
  // タブにファイルアイコンと Git ステータスを表示
  "tabs": {
    "file_icons": true,
    "git_status": true,
    // 閉じるボタンの表示 (hover / always / hidden)
    "show_close_button": "hover",
    // 閉じるボタンの位置 (left / right)
    "close_position": "right",
    // タブ上の診断表示 (off / errors / all)
    "show_diagnostics": "errors",
  },
  // タブバー本体の表示制御
  "tab_bar": {
    "show": true,
    // 戻る/進むのナビゲーションボタン
    "show_nav_history_buttons": true,
    // 右端の各種ボタン
    "show_tab_bar_buttons": true,
  },

  // ===== タイトルバー =====
  "title_bar": {
    "show_branch_name": true,
    "show_branch_status_icon": true,
    "show_project_items": true,
    // オンボーディング用バナーは非表示
    "show_onboarding_banner": false,
    "show_user_picture": true,
    "show_menus": true,
  },

  // ===== ツールバー・パンくず・ステータスバー =====
  // エディタ上部のツールバー
  "toolbar": {
    // パンくず (ファイルパス・シンボル階層)
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
    "agent_review": true,
  },
  // 下部ステータスバーのボタン類
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true,
    "active_encoding_button": "enabled",
  },
  // 行・桁インジケータの表示形式 (short / long)
  "line_indicator_format": "long",

  // ===== ウィンドウ =====
  // macOS のシステムウィンドウタブを使用 (cmd-` で切り替え可能)
  "use_system_window_tabs": true,
  // CLI (`zed` コマンド) でパスを開くときは常に新規ウィンドウで開く
  // (replace: 既存ウィンドウを置換 / add: 既存ウィンドウにタブ追加 / new_window: 新規ウィンドウ)
  "cli_default_open_behavior": "new_window",
  // 非アクティブなペインの強調 (境界線と不透明度)
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 0.9,
  },

  // ===== パネル配置 =====
  // プロジェクトツリーは左
  "project_panel": {
    "default_width": 240.0,
    "dock": "left",
    // エントリの行間 (comfortable / standard)
    "entry_spacing": "comfortable",
    "indent_size": 10.0,
    "folder_icons": true,
    "git_status": true,
    // 開いているファイルを自動的にツリー上で展開・選択
    "auto_reveal_entries": true,
    // 単独の子しか持たないディレクトリを折りたたんで表示
    "auto_fold_dirs": true,
    // フォルダ名を太字に
    "bold_folder_labels": true,
    // スクロール時に親フォルダを上部に固定
    "sticky_scroll": true,
  },
  // アウトラインパネルも左。プロジェクト検索の結果タブを開いた状態で
  // cmd-shift-b を押すと、検索結果が「ディレクトリ → ファイル → マッチ」の
  // ツリーで一覧できる (VS Code の検索サイドバーに近い表示)。
  // 見た目は project_panel に合わせる
  "outline_panel": {
    "default_width": 240.0,
    "dock": "left",
    "indent_size": 10.0,
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
  },
  // Git パネルも左に集約
  "git_panel": {
    "collapse_untracked_diff": true,
    "dock": "left",
  },
  // AI エージェントパネルは右
  "agent": {
    "dock": "right",
    // スレッド履歴サイドバー (cmd-alt-j) も右側に表示
    "sidebar_side": "right",
  },
  // ターミナルも右に配置してエージェントと並べる
  "terminal": {
    "max_scroll_history_lines": 1000000,
    "dock": "right",
    "env": {
      // Claude Code は TERM_PROGRAM の allowlist (iTerm/WezTerm/vscode 等) で
      // OSC 8 ハイパーリンク対応を判定し、Zed は非対応扱いで statusline の
      // リンクが剥がされる。強制的に有効化する
      // https://github.com/anthropics/claude-code/issues/26356
      "FORCE_HYPERLINK": "1",
      // Homebrew (Apple Silicon) と Google Cloud SDK のパスを通す。
      // Zed から起動するシェル/エージェントは .zshenv / .zshrc を読み込まないため、
      // gh / brew / gcloud などのコマンドが見つからない。ここで明示的に通す
      // (gcloud は本来 ~/google-cloud-sdk/path.zsh.inc を .zshrc から source して通す)
      "PATH": "/opt/homebrew/bin:/opt/homebrew/sbin:${HOME}/google-cloud-sdk/bin:${PATH}",
    },
    "working_directory": "current_project_directory",
    // ターミナルフォントは WezTerm (Menlo) に揃える。
    // 日本語は fallbacks 経由でヒラギノ丸ゴ ProN へ流す
    "font_family": "Menlo",
    "font_fallbacks": ["Hiragino Maru Gothic ProN"],
    // カーソルは WezTerm の BlinkingBlock に揃えるためブロック形状で点滅
    "cursor_shape": "block",
    "blinking": "on",
    // ツールバーに cwd のパンくずを表示
    "toolbar": {
      "breadcrumbs": true
    }
  },

  // ===== Git =====
  // 行ごとのインラインブレーム表示
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },

  // ===== AI エージェント =====
  // Claude Code を ACP (Agent Client Protocol) 経由で利用
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
      },
      "type": "registry",
    },
  },

  // ===== 拡張機能 =====
  // ここに列挙した拡張は Zed 起動時に自動でインストールされる。
  // 新しい拡張を入れたら必ずこのリストにも追記する (宣言的管理)
  "auto_install_extensions": {
    // ----- Languages -----
    "astro": true,
    "dockerfile": true,
    "html": true,
    "jsonl": true,
    "lua": true,
    "mdx": true,
    "sql": true,
    "toml": true,
    "xml": true,
    // ----- Themes -----
    "nvim-nightfox": true,
    // ----- Icon themes -----
    "material-icon-theme": true,
    // ----- Tools -----
    "git-firefly": true,
  },

  // ===== プライバシー・セッション =====
  // テレメトリ送信を無効化
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // すべての worktree を自動信頼 (プロンプト省略)
  "session": {
    "trust_all_worktrees": true,
  },

  // ===== フォーマッタ =====
  // 保存時フォーマットはファイル種別に関係なく無効化。
  // プロジェクト側のフォーマッター (Prettier / Biome 等) に委ねる
  // (デフォルト有効のままだと組み込みフォーマッターがシングルクォートを
  //  ダブルクォートに書き換えるなどの意図しない変換が走る)
  "format_on_save": "off",

  // ===== テーマ上書き (Terafox - blurred 用) =====
  // 旧 experimental.theme_overrides はテーマ横断の共通上書きで、拡張テーマ (nvim-nightfox
  // の Terafox - blurred など) 固有のキーを書き換えると効かないケースがある
  // (editor.subheader.background 等)。テーマ名をキーにネストする per-theme overrides
  // に移すと拡張テーマにも確実に反映される。
  // 参考: https://github.com/zed-industries/zed/pull/30860
  "theme_overrides": {
    "Terafox - blurred": {
      // ----- タブの視認性向上 -----
      // Terafox - blurred はアクティブ/非アクティブタブがどちらも半透明 (不透明度34%) かつ
      // ほぼ同色 (#293e4057 / #15252857) で判別しづらい。
      // 非アクティブを暗く沈め、アクティブだけ不透明な明るめのティール
      // (テーマの border.variant 色) にして差を付ける
      "tab_bar.background": "#0f1c1eE3",
      "tab.inactive_background": "#0f1c1eE3",
      "tab.active_background": "#2d4f56",
      // 非アクティブタブ等の文字色を一段落とす
      // (テーマは text.muted ≈ text でほぼ同色のため、背景色差だけでは弱い)
      "text.muted": "#cbd9d8",
      // macOS ネイティブのウィンドウタブ (プロジェクトタブ) はタイトルバー色に
      // 追従するため、少し明るい色にしてアクティブタブを判別しやすくする
      // 上流の既知問題: https://github.com/zed-industries/zed/issues/38238
      // まだ差が弱ければ #2d4f56 まで明るくするとアクティブなファイルタブと揃う
      "title_bar.background": "#1d3337",

      // ----- multibuffer / 未コミット差分ビューのファイルヘッダー -----
      // Terafox - blurred はデフォルトで background.appearance = blurred (透過ウィンドウ)。
      // Zed 本体 (crates/editor/src/element/header.rs) は透過ウィンドウでは
      // editor.subheader.background を意図的に塗らない実装 (`.when(opaque_window, ...)`) で、
      // 上書きしても効かない。ウィンドウ透過を opaque に切り替えて subheader を有効化する
      // (テーマの背景色 #152528E3 の alpha 自体はそのまま残る)
      "background.appearance": "opaque",
      // アクティブタブ (#2d4f56) より一段明るい不透明ティールにして
      // ファイル境界を強調する (明るすぎるとヘッダー内の文字が読みづらくなる)
      "editor.subheader.background": "#3d636c",

      // ----- エージェントパネル (ACP) の選択ハイライト -----
      // Markdown 描画はテキストの上に選択ハイライトを重ね塗りするため、
      // テーマの element.selection_background (#293e40, 不透明) だと文字が隠れる。
      // エディタ本体の選択色 players[0].selection (#7aa4a136) に合わせて透過させる
      "element.selection_background": "#7aa4a140",

      // ----- 検索ハイライト -----
      // Terafox - blurred のデフォルトはエディタ背景に近いグレーで埋もれる。
      // 暗いティール背景に映える暖色 (テーマの bright_yellow 系) を半透明で重ねて
      // 視認性を上げる。不透明度を上げすぎると文字が読みにくくなるので 50% 前後
      "search.match_background": "#fe801980",

      // ----- コメントの視認性向上 -----
      // Terafox - blurred のコメントは暗いティールグレーで本文に沈みがち。
      // 白寄りのライトグレーで一段持ち上げて読みやすくする
      // (italic 等の属性はテーマ側のデフォルトを維持するため color のみ上書き)
      "syntax": {
        "comment": {
          "color": "#94a4a4",
        },
        "comment.doc": {
          "color": "#94a4a4",
        },
      },
    },
  },

  // ===== 全テーマ共通の上書き =====
  // ターミナル配色は WezTerm と揃えるためライト/ダーク問わず Kanagawa Dragon に固定したい。
  // per-theme overrides に書くと Ayu Light 側にも同じ値を重複させる必要があるため、
  // テーマ横断で効く experimental.theme_overrides に残す
  "experimental.theme_overrides": {
    // ----- ターミナル配色 (Kanagawa Dragon / Gogh) -----
    // WezTerm 側の color_scheme = 'Kanagawa Dragon (Gogh)' と揃える。
    // ANSI カラーをターミナル背景込みで上書き
    "terminal.background": "#181616",
    "terminal.foreground": "#c5c9c5",
    "terminal.ansi.black": "#0d0c0c",
    "terminal.ansi.red": "#c4746e",
    "terminal.ansi.green": "#8a9a7b",
    "terminal.ansi.yellow": "#c4b28a",
    "terminal.ansi.blue": "#8ba4b0",
    "terminal.ansi.magenta": "#a292a3",
    "terminal.ansi.cyan": "#8ea4a2",
    "terminal.ansi.white": "#c8c093",
    "terminal.ansi.bright_black": "#a6a69c",
    "terminal.ansi.bright_red": "#e46876",
    "terminal.ansi.bright_green": "#87a987",
    "terminal.ansi.bright_yellow": "#e6c384",
    "terminal.ansi.bright_blue": "#7fb4ca",
    "terminal.ansi.bright_magenta": "#938aa9",
    "terminal.ansi.bright_cyan": "#7aa89f",
    "terminal.ansi.bright_white": "#c5c9c5",
  },
}
