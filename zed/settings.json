// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // ===== 外観 (テーマ・アイコン) =====
  // エディタのカラーテーマ。OS のダーク/ライトモードに追従
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  // ファイルツリー等で使うアイコンテーマ
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },

  // ===== フォント =====
  // UI 全体のフォントサイズ (サイドバー・コマンドパレット等)
  "ui_font_size": 16,
  // エディタ本文のフォントサイズ
  "buffer_font_size": 15,
  // エディタ本文のフォントウェイト (400 = Regular)
  "buffer_font_weight": 400,
  // エディタの行間 (standard / comfortable / custom)
  "buffer_line_height": "comfortable",

  // ===== エディタ表示 =====
  // 空白文字 (スペース・タブ) を常時可視化
  "show_whitespaces": "all",
  // タブにファイルアイコンと Git ステータスを表示
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },

  // ===== ウィンドウ =====
  // macOS のシステムウィンドウタブを使用 (cmd-` で切り替え可能)
  "use_system_window_tabs": true,

  // ===== パネル配置 =====
  // プロジェクトツリーは左
  "project_panel": {
    "dock": "left",
  },
  // Git パネルも左に集約
  "git_panel": {
    "dock": "left",
  },
  // AI エージェントパネルは右
  "agent": {
    "dock": "right",
  },
  // ターミナルも右に配置してエージェントと並べる
  "terminal": {
    "max_scroll_history_lines": 1000000,
    "dock": "right",
  },

  // ===== Git =====
  // 行ごとのインラインブレーム表示
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },

  // ===== AI エージェント =====
  // Claude Code を ACP (Agent Client Protocol) 経由で利用
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },

  // ===== プライバシー・セッション =====
  // テレメトリ送信を無効化
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // すべての worktree を自動信頼 (プロンプト省略)
  "session": {
    "trust_all_worktrees": true,
  },

  // ===== ターミナル配色 (Gruvbox 系) =====
  // ANSI カラーをターミナル背景込みで上書き
  "experimental.theme_overrides": {
    "terminal.background": "#0f1629",
    "terminal.ansi.black": "#1d2021",
    "terminal.ansi.red": "#cc241d",
    "terminal.ansi.green": "#98971a",
    "terminal.ansi.yellow": "#fe8019",
    "terminal.ansi.blue": "#458588",
    "terminal.ansi.magenta": "#b16286",
    "terminal.ansi.cyan": "#689d6a",
    "terminal.ansi.white": "#a89984",
    "terminal.ansi.bright_black": "#928374",
    "terminal.ansi.bright_red": "#fb4934",
    "terminal.ansi.bright_green": "#b8bb26",
    "terminal.ansi.bright_yellow": "#fe8019",
    "terminal.ansi.bright_blue": "#83a598",
    "terminal.ansi.bright_magenta": "#d3869b",
    "terminal.ansi.bright_cyan": "#8ec07c",
    "terminal.ansi.bright_white": "#ebdbb2",
  },
}
