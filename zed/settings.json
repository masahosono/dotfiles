// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // ===== 外観 (テーマ・アイコン) =====
  // エディタのカラーテーマ。OS のダーク/ライトモードに追従
  // dark: "Terafox - blurred" は nvim-nightfox 拡張に同梱
  //   https://zed.dev/extensions/nvim-nightfox
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Terafox - blurred",
  },
  // ファイルツリー等で使うアイコンテーマ
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },

  // ===== フォント =====
  // UI 全体のフォントサイズ (サイドバー・コマンドパレット等)
  "ui_font_size": 15,
  // エディタ本文のフォントサイズ
  "buffer_font_size": 12,
  // エディタ本文のフォントウェイト (400 = Regular)
  "buffer_font_weight": 400,
  // エディタの行間 (standard / comfortable / custom)
  "buffer_line_height": "comfortable",
  // フォントファミリーを固定したい場合は下記を有効化 (インストール済みフォント名)
  // "ui_font_family": ".SystemUIFont",
  // "buffer_font_family": ".ZedMono",
  // リガチャ (calt) を有効化
  "buffer_font_features": {
    "calt": true,
  },

  // ===== エディタ表示 =====
  // 空白文字 (スペース・タブ) を常時可視化
  "show_whitespaces": "all",
  // カーソル行のハイライト範囲 (none / gutter / line / all)
  "current_line_highlight": "all",
  // 選択中のテキストと同一の箇所をハイライト
  "selection_highlight": true,
  // 未使用コード (dead code) を薄く表示する不透明度 (0.0〜1.0)
  "unnecessary_code_fade": 0.4,
  // 折り返しガイド (縦ライン) を指定桁に表示
  "show_wrap_guides": true,
  "wrap_guides": [80, 100],

  // ----- カーソル -----
  // カーソル形状 (bar / block / underline / hollow)
  "cursor_shape": "bar",
  // カーソルの点滅
  "cursor_blink": true,
  // 入力中はマウスカーソルを隠す (never / on_typing / on_typing_and_action)
  "hide_mouse": "on_typing",

  // ----- インデントガイド -----
  // インデントの縦ガイド線
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    // ネストの深さに応じて色を変える (disabled / fixed / indent_aware)
    "coloring": "indent_aware",
    "background_coloring": "disabled",
  },

  // ----- ガター (行番号の列) -----
  "gutter": {
    "line_numbers": true,
    // テスト等の実行ボタン
    "runnables": true,
    // コード折りたたみハンドル
    "folds": true,
    // 行番号欄の最小桁数 (狭めて余白を節約)
    "min_line_number_digits": 3,
  },

  // ----- スクロールバー -----
  "scrollbar": {
    // 表示条件 (auto / system / always / never)
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    // 診断マーカーの表示レベル (none / error / warning / information / all)
    "diagnostics": "all",
  },

  // ----- ミニマップ -----
  "minimap": {
    // 表示条件 (auto / always / never)
    "show": "auto",
    // つまみの表示 (always / hover)
    "thumb": "hover",
    "thumb_border": "left_open",
  },

  // ===== タブ =====
  // タブにファイルアイコンと Git ステータスを表示
  "tabs": {
    "file_icons": true,
    "git_status": true,
    // 閉じるボタンの表示 (hover / always / hidden)
    "show_close_button": "hover",
    // 閉じるボタンの位置 (left / right)
    "close_position": "right",
    // タブ上の診断表示 (off / errors / all)
    "show_diagnostics": "errors",
  },
  // タブバー本体の表示制御
  "tab_bar": {
    "show": true,
    // 戻る/進むのナビゲーションボタン
    "show_nav_history_buttons": true,
    // 右端の各種ボタン
    "show_tab_bar_buttons": true,
  },

  // ===== タイトルバー =====
  "title_bar": {
    "show_branch_name": true,
    "show_branch_status_icon": true,
    "show_project_items": true,
    // オンボーディング用バナーは非表示
    "show_onboarding_banner": false,
    "show_user_picture": true,
    "show_menus": true,
  },

  // ===== ツールバー・パンくず・ステータスバー =====
  // エディタ上部のツールバー
  "toolbar": {
    // パンくず (ファイルパス・シンボル階層)
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
    "agent_review": true,
  },
  // 下部ステータスバーのボタン類
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true,
    "active_encoding_button": "enabled",
  },
  // 行・桁インジケータの表示形式 (short / long)
  "line_indicator_format": "long",

  // ===== ウィンドウ =====
  // macOS のシステムウィンドウタブを使用 (cmd-` で切り替え可能)
  "use_system_window_tabs": true,
  // 非アクティブなペインの強調 (境界線と不透明度)
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 0.9,
  },

  // ===== パネル配置 =====
  // プロジェクトツリーは左
  "project_panel": {
    "default_width": 240.0,
    "dock": "left",
    // エントリの行間 (comfortable / standard)
    "entry_spacing": "comfortable",
    "indent_size": 10.0,
    "folder_icons": true,
    "git_status": true,
    // 開いているファイルを自動的にツリー上で展開・選択
    "auto_reveal_entries": true,
    // 単独の子しか持たないディレクトリを折りたたんで表示
    "auto_fold_dirs": true,
    // フォルダ名を太字に
    "bold_folder_labels": true,
    // スクロール時に親フォルダを上部に固定
    "sticky_scroll": true,
  },
  // Git パネルも左に集約
  "git_panel": {
    "dock": "left",
  },
  // AI エージェントパネルは右
  "agent": {
    "dock": "right",
    // スレッド履歴サイドバー (cmd-alt-j) も右側に表示
    "sidebar_side": "right",
  },
  // ターミナルも右に配置してエージェントと並べる
  "terminal": {
    "max_scroll_history_lines": 1000000,
    "dock": "right",
  },

  // ===== Git =====
  // 行ごとのインラインブレーム表示
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },

  // ===== AI エージェント =====
  // Claude Code を ACP (Agent Client Protocol) 経由で利用
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "claude-opus-4-8",
      },
      "type": "registry",
    },
  },

  // ===== プライバシー・セッション =====
  // テレメトリ送信を無効化
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // すべての worktree を自動信頼 (プロンプト省略)
  "session": {
    "trust_all_worktrees": true,
  },

  // ===== フォーマッタ =====
  // 保存時フォーマットはファイル種別に関係なく無効化。
  // プロジェクト側のフォーマッター (Prettier / Biome 等) に委ねる
  // (デフォルト有効のままだと組み込みフォーマッターがシングルクォートを
  //  ダブルクォートに書き換えるなどの意図しない変換が走る)
  "format_on_save": "off",

  // ===== ターミナル配色 (Gruvbox 系) =====
  // ANSI カラーをターミナル背景込みで上書き
  "experimental.theme_overrides": {
    "terminal.background": "#0f1629",
    "terminal.ansi.black": "#1d2021",
    "terminal.ansi.red": "#cc241d",
    "terminal.ansi.green": "#98971a",
    "terminal.ansi.yellow": "#fe8019",
    "terminal.ansi.blue": "#458588",
    "terminal.ansi.magenta": "#b16286",
    "terminal.ansi.cyan": "#689d6a",
    "terminal.ansi.white": "#a89984",
    "terminal.ansi.bright_black": "#928374",
    "terminal.ansi.bright_red": "#fb4934",
    "terminal.ansi.bright_green": "#b8bb26",
    "terminal.ansi.bright_yellow": "#fe8019",
    "terminal.ansi.bright_blue": "#83a598",
    "terminal.ansi.bright_magenta": "#d3869b",
    "terminal.ansi.bright_cyan": "#8ec07c",
    "terminal.ansi.bright_white": "#ebdbb2",
  },
}
