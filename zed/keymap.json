// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // Cursor のキーマップに合わせたパネル切り替え
  //
  // 開閉が目的なら ToggleFocus ではなく Toggle を使う。
  // ToggleFocus はフォーカスを動かすだけで、開いているパネルを閉じない。
  {
    "context": "Workspace",
    "bindings": {
      "cmd-1": "project_panel::Toggle",
      "cmd-2": "git_panel::Toggle",
      "cmd-3": "terminal_panel::Toggle",
      "cmd-4": "agent::Toggle",
      "cmd-5": "multi_workspace::ToggleWorkspaceSidebar",
    },
  },
  // git panel フォーカス時の cmd-1 / cmd-2 上書き。
  // デフォルトでは GitPanel コンテキストで Changes/History タブ切替に
  // 取られてしまうため再定義する。
  // - cmd-1: project panel に切り替え
  // - cmd-2: git panel を閉じる
  {
    "context": "GitPanel",
    "bindings": {
      "cmd-1": "project_panel::Toggle",
      "cmd-2": "git_panel::Toggle",
    },
  },
  // macOS のシステムウィンドウタブ切り替え。
  // settings.json の use_system_window_tabs: true と対で機能する。
  {
    "bindings": {
      "cmd-`": "window::ShowNextWindowTab",
      "cmd-~": "window::ShowPreviousWindowTab",
    },
  },
  // cmd-q による誤操作での強制終了を防ぐため無効化する。
  // 終了したいときはメニューバーから Zed → Quit Zed を選ぶ。
  {
    "bindings": {
      "cmd-q": null,
    },
  },
  // ターミナル内での分割・タブ・ペイン移動
  // - cmd+t         : tasks.json の "shell" task を起動 (ラベル付き新規タブ)
  // - cmd+d         : 右に分割
  // - cmd+shift+d   : 下に分割
  // - cmd+[ / cmd+] : ペイン間を前後に移動
  {
    "context": "Terminal",
    "bindings": {
      "cmd-t": "workspace::NewTerminal",
      "cmd-d": "pane::SplitRight",
      "cmd-shift-d": "pane::SplitDown",
      "cmd-[": "workspace::ActivatePreviousPane",
      "cmd-]": "workspace::ActivateNextPane",
    },
    "unbind": {},
  },
  // エディター内での分割（ターミナルと同じ感覚で扱えるように合わせる）
  // - cmd+d       : 右に分割
  // - cmd+shift+d : 下に分割
  // - cmd+g       : 置換バーを開く（デフォルトの SelectNextMatch を上書き）
  // - cmd+shift+g : プロジェクト検索を置換フォーム付きで開く
  // デフォルトの cmd+d (editor::SelectNext) は上書きされる。
  {
    "context": "Editor",
    "bindings": {
      "cmd-d": "pane::SplitRight",
      "cmd-shift-d": "pane::SplitDown",
      "cmd-g": "buffer_search::DeployReplace",
      "cmd-shift-g": ["pane::DeploySearch", { "replace_enabled": true }],
    },
  },
  // 検索バーが開いている時に cmd+g で置換欄の表示をトグルする
  {
    "context": "BufferSearchBar",
    "bindings": {
      "cmd-g": "search::ToggleReplace",
    },
  },
]
