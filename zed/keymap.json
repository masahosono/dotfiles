// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // Cursor のキーマップに合わせたパネル切り替え
  //
  // 開閉が目的なら ToggleFocus ではなく Toggle を使う。
  // ToggleFocus はフォーカスを動かすだけで、開いているパネルを閉じない。
  {
    "context": "Workspace",
    "bindings": {
      "cmd-1": "workspace::ToggleLeftDock",
      "cmd-2": "git_panel::Toggle",
      "cmd-3": "terminal_panel::Toggle",
    },
  },
  // ターミナル内での分割とペイン移動
  // - cmd+d         : 右に分割
  // - cmd+shift+d   : 下に分割
  // - cmd+[ / cmd+] : ペイン間を前後に移動
  {
    "context": "Terminal",
    "bindings": {
      "cmd-d": "pane::SplitRight",
      "cmd-shift-d": "pane::SplitDown",
      "cmd-[": "workspace::ActivatePreviousPane",
      "cmd-]": "workspace::ActivateNextPane",
    },
    "unbind": {},
  },
]
