# Ghostty 設定ファイル
# 形式: key = value
# デフォルト値とドキュメント一覧: ghostty +show-config --default --docs

# --- テーマ ---
# WezTerm (wezterm/wezterm.lua) と揃えた配色。Gruvbox Dark Hard がベースだが、
# yellow は緑寄りで green と判別しづらいため orange (#fe8019) に差し替えている。
# background は WezTerm 側と同じ紺色にする。
# 利用可能なプリセット一覧: ghostty +list-themes
background = 0f1629
foreground = ebdbb2
cursor-color = ebdbb2
selection-background = 3c3836
selection-foreground = ebdbb2

# ANSI 0-7 (通常)
palette = 0=#1d2021
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#fe8019
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
# ANSI 8-15 (bright)。11 (bright yellow) も orange に揃える
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fe8019
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

# --- 背景 ---
# 背景をぼかすには background-opacity を 1 未満にする必要がある。
# WezTerm (wezterm/wezterm.lua) の opacity=0.80 / blur=15 に揃えつつ、
# 透明度は少し控えめの 0.92 に。blur は macOS のガウシアン強度で 20 前後。
background-opacity = 0.92
background-blur = 20
# 前景色と背景色のコントラスト比の下限（1.0=強制なし、4.5=WCAG AA 相当）
# minimum-contrast = 2.5

# --- ウィンドウ動作 ---
# Cmd+W などでサーフェスを閉じる際の確認ダイアログを抑止する
confirm-close-surface = false
# スクロールバックの保持行数（デフォルト 10000 行）
scrollback-limit = 100000
# 新規タブ (Cmd+T) と新規ウィンドウ (Cmd+N) はホームディレクトリで開く。
# Split は split-inherit-working-directory のデフォルト (true) に従って引き継ぐ。
# working-directory を明示しておかないと CLI 起動時に inherit がフォールバックになるため、
# フォールバック先として home を明示する。
tab-inherit-working-directory = false
window-inherit-working-directory = false
working-directory = home
# アプリ再起動時に前回のウィンドウ状態（作業ディレクトリ含む）を復元しない。
# これがないと working-directory = home の指定が macOS の状態復元に上書きされる。
window-save-state = never

# --- アイコン ---
# Dock とアプリケーションスイッチャーに表示されるアイコンを独自のものに差し替える。
# Finder アイコンは署名バンドル内で固定のため変更不可。
# 参照: https://ghostty.org/docs/config/reference#macos-custom-icon
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/custom.icns

# --- フォント ---
# 日本語（CJK 記号・ひらがな・カタカナ・漢字・全角形）だけヒラギノ丸ゴ ProN に差し替える。
# 英文部分は Ghostty デフォルト（macOS では SF Mono 系）のまま。
font-codepoint-map = U+3000-U+30FF,U+4E00-U+9FFF,U+FF00-U+FFEF=Hiragino Maru Gothic ProN
font-size = 12
