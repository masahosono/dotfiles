# 補完
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select                          # Tab で補完候補をメニュー選択可能に
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # 補完時に大文字小文字を区別しない
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}       # 補完候補を LS_COLORS で色付け
zstyle ':completion:*:default' menu select=2                # 候補が2つ以上のとき選択メニューを表示
setopt auto_param_slash                                     # ディレクトリ名補完時に末尾 / を自動付与
setopt list_packed                                          # 補完候補をコンパクトに表示

# シェルオプション
setopt auto_cd                                              # ディレクトリ名だけで cd
setopt auto_pushd                                           # cd 時に自動で pushd（移動履歴をスタックに積む）
setopt pushd_ignore_dups                                    # pushd スタックに同じディレクトリを積まない
setopt correct                                              # コマンドのタイポを指摘・修正候補を提示
setopt no_beep                                              # ビープ音を鳴らさない
DIRSTACKSIZE=20                                             # pushd スタックの最大サイズ

# ヒストリー
HISTFILE=~/.zsh_history                                     # ヒストリー保存先
HISTSIZE=100000                                             # メモリ上に保持するヒストリー件数
SAVEHIST=100000                                             # ファイルに保存するヒストリー件数
setopt share_history                                        # 複数の zsh セッション間でヒストリーを共有
setopt hist_ignore_dups                                     # 直前と同じコマンドは記録しない
setopt hist_ignore_all_dups                                 # 重複コマンドは古い方を削除
setopt hist_ignore_space                                    # 行頭スペース付きコマンドは記録しない
setopt hist_reduce_blanks                                   # 余分な空白を除去して記録
setopt hist_verify                                          # `!!` などのヒストリ展開を即実行せず確認
setopt extended_history                                     # 実行時刻と所要時間も記録

# キーバインド
bindkey "^P" history-beginning-search-backward              # Ctrl+P で前方一致ヒストリ検索（前）
bindkey "^N" history-beginning-search-forward               # Ctrl+N で前方一致ヒストリ検索（次）
# Ctrl+L の clear-screen を無効化
bindkey -r "^L"

# TIMEFMT
TIMEFMT=$'\n\n========================\nProgram : %J\nCPU     : %P\nuser    : %*Us\nsystem  : %*Ss\ntotal   : %*Es\n========================\n'
