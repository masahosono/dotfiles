# エイリアス
# 環境に依存しない汎用的なエイリアスをここに集約する
# PATH や API キーなど環境固有のものは ~/.zshrc に書くこと

# 短縮: よく使うコマンドを 1〜2 文字で叩く
alias c='claude'
alias cl='clear'
alias h='herdr'
alias n='nvim'

# ls: 隠しファイル含む詳細表示（種別記号付き・サイズ可読）
alias ll='ls -lAFh'

# git: 状態確認
alias gits='git status'

# git: skip-worktree されているファイルを一覧
alias git-skipped='git ls-files -v | grep "^S"'

# Ghostty から Claude Code を起動するときだけ --name にホーム相対のパスを渡し、
# Claude Code が書き換えるタブタイトルを ~/path/to/dir 形式に揃える。
claude() {
  if [[ "$TERM_PROGRAM" == "ghostty" ]]; then
    command claude --name "${PWD/#$HOME/~}" "$@"
  else
    command claude "$@"
  fi
}
